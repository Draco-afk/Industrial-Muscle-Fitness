rules_version = '2';

// All reads/writes go through Cloud Functions using the Admin SDK, which
// bypasses these rules entirely (mirrors the original design where the
// client never touched the Sheet directly, only Apps Script server functions
// did). Direct client access to Firestore is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
